# Copy to .env for local development. Never commit production secrets.
APP_NAME=OrderFlow
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./orderflow.db
SESSION_HTTPS_ONLY=false
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=3
# In development, tables are created automatically. Production uses Alembic migrations.
AUTO_CREATE_TABLES=true
